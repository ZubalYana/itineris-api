// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TripRole {
  OWNER
  COLLABORATOR
}
enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model TripMember {
  id       String   @id @default(uuid())
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId   String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  role     TripRole
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
}

model User {
  id              String       @id @default(uuid())
  name            String
  email           String       @unique
  password        String
  emailVerified   DateTime?
  avatar          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sentInvites     Invite[]     @relation("InvitesSent")
  tripMemberships TripMember[]
}

model Trip {
  id          String       @id @default(uuid())
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  members     TripMember[]
  places      Place[]
  invites     Invite[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Place {
  id           String   @id @default(uuid())
  locationName String
  notes        String?
  dayNumber    Int
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Invite {
  id            String      @id @default(uuid())
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId        String
  invitedEmail  String
  token         String      @unique
  status        InviteStatus @default(PENDING)
  invitedBy     User        @relation("InvitesSent", fields: [invitedById], references: [id])
  invitedById   String
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([tripId, invitedEmail, status])
}

